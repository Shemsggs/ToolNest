# apps/web/.env.local (copy and fill)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
# Enable only in a private development or staging environment.
TOOLNEST_SERVER_PROCESSING_ENABLED=false
# For the Python worker use SUPABASE_URL and the service-role key in services/processor/.env
SUPABASE_URL=http://127.0.0.1:54321
